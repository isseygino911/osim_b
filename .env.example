# Optional: comma-separated list of allowed frontend origins for CORS. Defaults to
# http://localhost:5173, http://localhost:3000, and https://osim.isseylab.com if unset.
# Set this explicitly in production to lock CORS down to only the real frontend origin(s).
# CORS_ORIGIN=https://osim.isseylab.com

# Optional: enables Gemini AI news analysis (see root CLAUDE.md).
# GEMINI_API_KEY=your-key-here
# GEMINI_MODEL=gemini-2.5-flash-lite

# Optional: requires POST /api/snapshot callers to send this value in an
# X-Snapshot-Token header. Unset (default) = no auth check, open like today.
# SNAPSHOT_TOKEN=your-shared-secret-here

# Required for snapshot refreshes (server/services/tradier.service.js). "Go" /
# POST /api/refresh fetches quotes/chains/candles straight from Tradier's REST API
# in-process (a few seconds), and a background loop keeps every snapshotted symbol
# refreshed every few minutes. Get a token from a Tradier brokerage account (no funding
# required) at dash.tradier.com/settings/api. Unset = refresh requests fail with a
# clear error until this is set.
# TRADIER_API_KEY=your-tradier-api-token
